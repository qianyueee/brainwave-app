# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bridge (PC側プログラム)
bridge/.env
bridge/logs/
bridge/__pycache__/
bridge/bridge_config.json
bridge/build/
bridge/dist/
*.pyc

# Windows app (bridge/desktop_app.py)
bridge/web/
bridge/profile/
bridge/desktop_config.json
bridge/neurosync_desktop.log*

# Android app (Capacitor): the web bundle `pnpm build:android` writes for
# `cap sync` (a filtered copy of out/). android/ keeps its own .gitignore for
# the Gradle outputs and the synced assets.
/android-web/

# Local staging for the zodiac music source files (never committed)
.zodiac-src/
